<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ProjectAFS.Core.MarkupExtensions.Globalization;assembly=ProjectAFS.Core"
        xmlns:vmb="clr-namespace:ProjectAFS.Core.Models.ViewModelBindings;assembly=ProjectAFS.Core"
        xmlns:b="clr-namespace:ProjectAFS.Core.Models.Bindings.Welcome;assembly=ProjectAFS.Core"
        x:Class="ProjectAFS.Shell.Desktop.UI.Windows.WinWelcome"
        Title="Welcome to project-afs"
        Background="#F3F3F3"
        Width="1000" Height="650">
    
    <Design.DataContext>
        <vmb:DesignWelcomeViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *" Margin="40,30">
        <TextBlock Grid.Row="0" Text="project-afs" 
                   FontSize="44" FontFamily="Sriracha" Foreground="DarkOrange" 
                   Margin="0,0,0,40" />

        <Grid Grid.Row="1" ColumnDefinitions="*, 450">
            
            <DockPanel Grid.Column="0" Margin="0,0,50,0">
                <TextBlock DockPanel.Dock="Top" Text="{l:Localized Key='welcome.recent_projects', DesignTime='Select a recent project'}"
                           FontSize="22" Margin="0,0,0,20"/>
                
                <TextBox DockPanel.Dock="Top" Watermark="{l:Localized Key='welcome.recent_projects.search_placeholder', DesignTime='Search recent projects...'}"
                         Margin="0,0,0,10"/>

                <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding RecentProjects}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="b:RecentProjectItem">
                            <Button Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="#333333"/>
                                    <TextBlock Text="{Binding SolutionFilePath}" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <StackPanel Grid.Column="1" Spacing="10">
                <TextBlock Text="{l:Localized Key='welcome.get_started', DesignTime='...or get started from an operation'}"
                           FontSize="22" Margin="0,0,0,10"/>

                <Button HorizontalAlignment="Stretch" Height="80" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Margin="15,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Localized Key='welcome.new_solution', DesignTime='Create Solution'}" FontSize="18" FontWeight="Medium"/>
                            <TextBlock Text="{l:Localized Key='welcome.new_solution.description', DesignTime='Choose a template with basic fanmade structure to get started'}" FontSize="13" Foreground="Gray"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button HorizontalAlignment="Stretch" Height="80" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Margin="15,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Localized Key='welcome.open_solution', DesignTime='Open a Project or a Solution'}" FontSize="18" FontWeight="Medium"/>
                            <TextBlock Text="{l:Localized Key='welcome.open_solution.description', DesignTime='Open a local AFS project or .afsln file'}" FontSize="13" Foreground="Gray"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <HyperlinkButton Content="{l:Localized Key='welcome.skip', DesignTime='Continue without fanmade'}"
                                 HorizontalAlignment="Right" 
                                 Margin="0,20,0,0" 
                                 Foreground="#0066CC"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>