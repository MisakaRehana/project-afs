<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmb="clr-namespace:ProjectAFS.Shell.Desktop.MVVM.ViewModels.Welcome"
        xmlns:pages="clr-namespace:ProjectAFS.Shell.Desktop.UI.Pages.Welcome"
        x:Class="ProjectAFS.Shell.Desktop.UI.Windows.WinWelcome"
        Width="1000" Height="650" MinWidth="1000" MinHeight="650" MaxWidth="1000" MaxHeight="650"
        ExtendClientAreaToDecorationsHint="True" CanResize="False"
        Closing="Window_OnClosing"
        FontFamily="{StaticResource GlobalFontFamily}"
        Title="Welcome to project-afs">
	<Design.DataContext>
		<vmb:DesignWelcomeViewModel />
	</Design.DataContext>
	<Window.DataTemplates>
		<DataTemplate DataType="{x:Type vmb:PgeHomeViewModel}">
			<pages:PgeHome />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vmb:PgeNewProjectViewModel}">
			<pages:PgeNewProject />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vmb:PgeConfigProjectViewModel}">
			<pages:PgeConfigProject />
		</DataTemplate>
	</Window.DataTemplates>
	
	<Grid Margin="40, 30">
		<TransitioningContentControl Content="{Binding CurrentPage}" />
	</Grid>
</Window>