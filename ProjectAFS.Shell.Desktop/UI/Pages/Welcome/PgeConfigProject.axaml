<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:ProjectAFS.Core.MarkupExtensions.Globalization;assembly=ProjectAFS.Core"
             xmlns:vm="clr-namespace:ProjectAFS.Shell.Desktop.MVVM.ViewModels.Welcome"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="ProjectAFS.Shell.Desktop.UI.Pages.Welcome.PgeConfigProject"
             FontFamily="{StaticResource GlobalFontFamily}">
	<Design.DataContext>
		<vm:DesignPgeConfigProjectViewModel />
	</Design.DataContext>
	<UserControl.Styles>
		<Style Selector="TextBlock.PathText" /> <!-- Make IntelliSense shut up - it is included in AFSApp Application-level styles -->
	</UserControl.Styles>
	<Grid RowDefinitions="Auto, *, Auto">
		<StackPanel Grid.Row="0" Spacing="15" Margin="0, 0, 0, 30">
			<TextBlock Text="{l:Localized Key='welcome.config_project.title', DesignTime='Configure New Project'}"
			           FontSize="28" Margin="0,0,0,20" />
			<StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
				<TextBlock Text="{Binding TemplateName, FallbackValue='Standard Fanmade Project'}"
				           FontSize="18" FontWeight="SemiBold" />
				<ItemsControl ItemsSource="{Binding TemplatePlatforms}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal" Spacing="8" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="3" Padding="8, 2">
								<TextBlock Text="{Binding }" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</StackPanel>
		<ScrollViewer Grid.Row="1">
			<StackPanel Spacing="20" MaxWidth="700" HorizontalAlignment="Left">
				<StackPanel Spacing="5" Width="700">
					<TextBlock FontWeight="Bold">
						<TextBlock.Text>
							<Binding Path="ProjectNameTitle">
								<Binding.Converter></Binding.Converter>
								<Binding.FallbackValue>Project Name</Binding.FallbackValue>
							</Binding>
						</TextBlock.Text>
					</TextBlock>
					<TextBox Text="{Binding ProjectName}" />
				</StackPanel>
				<StackPanel Spacing="5" Width="700">
					<TextBlock Text="{l:Localized Key='welcome.config_project.location', DesignTime='Location'}" FontWeight="Bold" />
					<Grid ColumnDefinitions="*, 10, Auto">
						<TextBox Grid.Column="0" Text="{Binding ProjectLocation}" Classes="PathText" />
						<Button Grid.Column="2" Content="..." Command="{Binding BrowseLocationCommand}" Width="40" />
					</Grid>
				</StackPanel>
				
				<StackPanel Spacing="5" Width="700" IsVisible="{Binding ShowSolutionSettings}">
					<TextBlock Text="{l:Localized Key='welcome.config_project.solution_name', DesignTime='Solution Name'}" FontWeight="Bold" />
					<TextBox Text="{Binding SolutionName}"
					        IsEnabled="{Binding !PlaceInSameDirectory}" />
				</StackPanel>
				
				<CheckBox Content="{l:Localized Key='welcome.config_project.place_same_directory', DesignTime='Place solution and project in the same directory'}"
				          IsChecked="{Binding PlaceInSameDirectory}"
				          IsVisible="{Binding ShowSolutionSettings}" />
				
				<TextBlock TextWrapping="Wrap"
				           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
				           FontSize="13" Margin="0,10,0,0" Classes="PathText">
					<TextBlock.Text>
						<Binding Path="FinalPathPreview">
							<Binding.FallbackValue>
								<![CDATA[Project will be created at "C:\Projects\MyProject"]]>
							</Binding.FallbackValue>
						</Binding>
					</TextBlock.Text>
				</TextBlock>
			</StackPanel>
		</ScrollViewer>
		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="10" Margin="0,0,0,10">
			<Button Content="{l:Localized Key='ui.common.button.prev', DesignTime='_Back'}" Width="100" Command="{Binding PrevCommand}" />
			<Button Content="{l:Localized Key='welcome.config_project.button.create', DesignTime='_Create'}" Width="100" Command="{Binding NextCommand}" />
		</StackPanel>
	</Grid>
</UserControl>