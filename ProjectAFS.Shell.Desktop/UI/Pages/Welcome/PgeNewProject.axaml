<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ProjectAFS.Core.MarkupExtensions.Globalization;assembly=ProjectAFS.Core"
             xmlns:vm="clr-namespace:ProjectAFS.Shell.Desktop.MVVM.ViewModels.Welcome"
             xmlns:b="clr-namespace:ProjectAFS.Shell.Desktop.MVVM.Bindings.Welcome"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="ProjectAFS.Shell.Desktop.UI.Pages.Welcome.PgeNewProject"
             FontFamily="cjkFonts 全瀨體, SetoFont, Noto Sans CJK SC, Microsoft YaHei UI, Segoe UI, sans-serif">
    <Design.DataContext>
        <vm:DesignPgeNewProjectViewModel />
    </Design.DataContext>
    
    <Grid RowDefinitions="Auto, *">
        <TextBlock Grid.Row="0" Text="{l:Localized Key='welcome.new_project.title', DesignTime='Create New Project'}" FontSize="28" Margin="0,0,0,20"/>

        <Grid Grid.Row="1" ColumnDefinitions="300, *">
            <DockPanel Grid.Column="0" Margin="0,0,30,0">
                <TextBlock DockPanel.Dock="Top"
                           Text="{l:Localized Key='welcome.new_project.recent_templates', DesignTime='Latest Project Templates'}"
                            Margin="0,0,0,10" FontWeight="SemiBold" />
                <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding RecentTemplates}">
                </ListBox>
            </DockPanel>

            <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto">
                <StackPanel Grid.Row="0">
                    <TextBox Watermark="{l:Localized Key='welcome.new_project.search_templates', DesignTime='Search templates (Alt+S)'}" 
                             Width="400" HorizontalAlignment="Right"/>
                </StackPanel>

                <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,10,0,0" MinHeight="300" ItemsSource="{Binding Templates}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="b:ProjectTemplateItem">
                            <Grid ColumnDefinitions="Auto, *" Margin="5" Background="Transparent">
                                <Image Grid.Column="0" Width="40" Height="40" VerticalAlignment="Top" Margin="0,5,15,0"/>
                                
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}"
                                               TextWrapping="Wrap" FontSize="13"/>
                                    <ItemsControl ItemsSource="{Binding Platforms}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,5,0,0"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="sys:String">
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="10" Margin="0,0,0,10">
                    <Button Content="{l:Localized Key='ui.common.button.prev', DesignTime='_Back'}" Width="100" Command="{Binding PrevCommand}" />
                    <Button Content="{l:Localized Key='ui.common.button.next', DesignTime='_Next'}" Width="100" IsEnabled="{Binding CanGoNext}" Command="{Binding NextCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>