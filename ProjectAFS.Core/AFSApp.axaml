<Application xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ProjectAFS.Core.AFSApp"
        RequestedThemeVariant="Default">
	<Application.Styles>
	    <FluentTheme />
	    <StyleInclude Source="avares://ProjectAFS.Resources/Framework/Styles/GlobalFonts.axaml" />
	    <StyleInclude Source="avares://ProjectAFS.Resources/Framework/Styles/PathTextFonts.axaml" />
    </Application.Styles>
</Application>
